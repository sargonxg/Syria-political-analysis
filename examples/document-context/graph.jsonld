      "@type": "policy:LegalInstrument",
      "rdfs:label": "Security Council resolution 2254 (2015)"
    },
    {
      "@id": "urn:tacitus:semantic:entity:objective-norm-2254-op4-process",
      "@type": "policy:NormativeObjective",
      "rdfs:label": "A Syrian-led political process facilitated by the United Nations"
    },
    {
      "@id": "urn:tacitus:semantic:entity:objective-norm-2254-op4-governance",
      "@type": "policy:NormativeObjective",
      "rdfs:label": "Credible, inclusive and non-sectarian governance"
    },
    {
      "@id": "urn:tacitus:semantic:entity:objective-norm-2254-op4-constitution",
      "@type": "policy:NormativeObjective",
      "rdfs:label": "A schedule and process for drafting a new constitution"
    },
    {
      "@id": "urn:tacitus:semantic:entity:objective-norm-2254-op4-elections",
      "@type": "policy:NormativeObjective",
      "rdfs:label": "Free and fair elections pursuant to a new constitution"
    },
    {
      "@id": "urn:tacitus:semantic:span:op-4",
      "@type": "policy:EvidenceSpan",
      "prov:wasDerivedFrom": {
        "@id": "urn:tacitus:semantic:document:unsc-2254-excerpts"
      },
      "policy:quote": "4. Expresses its support, in this regard, for a Syrian-led political process that is facilitated by the United Nations and, within a target of six months, establishes credible, inclusive and non-sectarian governance and sets a schedule and process for drafting a new constitution, and further expresses its support for free and fair elections, pursuant to the new constitution, to be held within 18 months and administered under supervision of the United Nations, to the satisfaction of the governance and to the highest international standards of transparency and accountability, with all Syrians, including members of the diaspora, eligible to participate, as set forth in the 14 November 2015 ISSG Statement;",
      "policy:startUTF16": 481,
      "policy:endUTF16": 1192,
      "policy:locator": "Operative paragraph 4, printed page 2/4"
    },
