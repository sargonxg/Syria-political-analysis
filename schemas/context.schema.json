{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonxg/Syria-political-analysis/blob/main/schemas/context.schema.json",
  "title": "Context",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "record_type",
      "summary",
      "source_ids",
      "evidence",
      "scope",
      "limits",
      "checked_on"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "record_type": {
        "enum": [
          "research_question",
          "institutional_context",
          "dated_document_context"
        ]
      },
      "summary": {
        "type": "string"
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "document_id",
            "locator"
          ],
          "properties": {
            "document_id": {
              "type": "string"
            },
            "locator": {
              "type": "string"
            },
            "original_passage": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "scope": {
        "type": "object"
      },
      "limits": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "checked_on": {
        "type": "string",
        "format": "date"
      }
    },
    "additionalProperties": true
  }
}
