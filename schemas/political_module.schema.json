{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonxg/Syria-political-analysis/blob/main/schemas/political_module.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "country_code",
    "title",
    "status",
    "concepts",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pref_label",
          "scope_note",
          "terminology_basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pref_label": {
            "type": "object",
            "required": [
              "en"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "scope_note": {
            "type": "string",
            "minLength": 1
          },
          "broader": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "terminology_basis": {
            "type": "object",
            "required": [
              "reference_id",
              "locator",
              "url",
              "verification"
            ],
            "properties": {
              "reference_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "verification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "verification"
        ]
      }
    }
  }
}
