{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonxg/Syria-political-analysis/blob/main/schemas/claims.schema.json",
  "title": "Claims",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "statement",
      "theme",
      "evidence",
      "place_ids",
      "review_state",
      "geographic_scope",
      "qualification",
      "checked_on"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "statement": {
        "type": "string"
      },
      "theme": {
        "type": "string"
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "document_id",
            "locator"
          ],
          "properties": {
            "document_id": {
              "type": "string"
            },
            "locator": {
              "type": "string"
            },
            "original_passage": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "place_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "review_state": {
        "enum": [
          "unreviewed_reference",
          "needs_source_check",
          "curated_paraphrase",
          "corroborated",
          "disputed",
          "superseded"
        ]
      },
      "geographic_scope": {
        "type": "string"
      },
      "qualification": {
        "type": "string"
      },
      "checked_on": {
        "type": "string",
        "format": "date"
      }
    },
    "additionalProperties": true
  }
}
