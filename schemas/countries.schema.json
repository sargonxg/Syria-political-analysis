{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonxg/Syria-political-analysis/blob/main/schemas/countries.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "default_country",
    "countries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "region",
          "workspace",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "workspace": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
