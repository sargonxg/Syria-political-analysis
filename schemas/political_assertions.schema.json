{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonxg/Syria-political-analysis/blob/main/schemas/political_assertions.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "country_code",
      "subject_id",
      "relation_id",
      "object_id",
      "statement",
      "attributed_to",
      "modality",
      "temporal_scope",
      "qualifications",
      "review_state",
      "human_review_recorded",
      "evidence",
      "concept_ids",
      "coordinates"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "subject_id": {
        "type": "string",
        "minLength": 1
      },
      "relation_id": {
        "type": "string",
        "minLength": 1
      },
      "object_id": {
        "type": "string",
        "minLength": 1
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "attributed_to": {
        "type": "string",
        "minLength": 1
      },
      "country_code": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "document_id",
            "locator"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "coordinates": {
        "type": "null"
      },
      "concept_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "qualifications": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "review_state": {
        "enum": [
          "needs_source_check",
          "curated_paraphrase",
          "corroborated",
          "disputed",
          "superseded"
        ]
      },
      "human_review_recorded": {
        "type": "boolean"
      },
      "review_activity_id": {
        "type": "string",
        "minLength": 1
      },
      "modality": {
        "type": "object",
        "required": [
          "kind",
          "source_verb",
          "implementation_asserted"
        ],
        "properties": {
          "kind": {
            "enum": [
              "normative_expression",
              "reported_action",
              "analyst_interpretation"
            ]
          },
          "source_verb": {
            "type": "string",
            "minLength": 1
          },
          "implementation_asserted": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "normative_expression"
                }
              }
            },
            "then": {
              "properties": {
                "implementation_asserted": {
                  "const": false
                }
              }
            }
          }
        ]
      },
      "temporal_scope": {
        "type": "object",
        "required": [
          "kind",
          "source_statement_on",
          "implementation_period_verified",
          "current_applicability_assessed"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_statement_on": {
            "type": "string",
            "format": "date"
          },
          "implementation_period_verified": {
            "type": "boolean"
          },
          "current_applicability_assessed": {
            "type": "boolean"
          },
          "source_target_expression": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "primary_text_checked_on": {
        "type": "string",
        "format": "date"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "human_review_recorded": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "review_activity_id"
          ]
        }
      }
    ]
  }
}
