{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonxg/Syria-political-analysis/blob/main/schemas/political_entities.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "country_code",
      "type",
      "label",
      "status",
      "evidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "country_code": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "type": {
        "type": "string",
        "minLength": 1
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "document_id",
            "locator"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "additionalProperties": true
  }
}
