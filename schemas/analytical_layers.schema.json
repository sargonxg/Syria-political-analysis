{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "record_type",
      "purpose",
      "evidence",
      "questions",
      "map_policy"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "document_id",
            "locator"
          ],
          "properties": {
            "document_id": {
              "type": "string"
            },
            "locator": {
              "type": "string"
            }
          }
        }
      },
      "map_policy": {
        "type": "object"
      }
    }
  }
}
