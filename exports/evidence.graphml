><node id="doc-6a6a58332d921b07"><data key="label">Comprehensive Overview of Refugee Returns Dashboard — Syrian Arab Republic, as of 29 October 2026</data><data key="type">document</data></node><node id="doc-427ee7a72090ffab"><data key="label">Mandate — Office of the Special Envoy of the Secretary-General for Syria</data><data key="type">document</data></node><node id="doc-83ad8cbb868c0c88"><data key="label">Resolution 2254 (2015), adopted by the Security Council on 18 December 2015</data><data key="type">document</data></node><node id="doc-195dc9a7e6f261bf"><data key="label">Report of the Independent International Commission of Inquiry on the Syrian Arab Republic</data><data key="type">document</data></node><node id="doc-cbd0bcfb486a0fc4"><data key="label">United Nations Office for the Coordination of Humanitarian Affairs — UN Geneva organizational profile</data><data key="type">document</data></node><node id="doc-fa2f1d6631839bff"><data key="label">اعتقالات وتهديدات وتوغلات لقوات الاحتلال الإسرائيلي في الجنوب السوري يوم 1 تشرين الثاني 2026</data><data key="type">document</data></node><node id="doc-6b34c80d2a35b578"><data key="label">العثور على شاب متوفى في مدينة إنخل شمالي درعا</data><data key="type">document</data></node><node id="doc-2ad8fd328258c527"><data key="label">مقتل يافع طعناً إثر مشاجرة في مدينة نوى</data><data key="type">document</data></node><node id="doc-cc13dc3f2e304261"><data key="label">توثيق الانتهاكات والأحداث الأمنية – تشرين الأول 2026</data><data key="type">document</data></node><node id="doc-2b0c275512ba255c"><data key="label">Syria can speak freely, but is its government listening?</data><data key="type">document</data></node><node id="doc-d59c2c5f02b34266"><data key="label">إحباط تهريب مخدرات على الحدود السورية الأردنية</data><data key="type">document</data></node><node id="doc-8a9ce24774fbb4ab"><data key="label">وفاة شاب شرقي درعا إثر خلاف عائلي</data><data key="type">document</data></node><node id="doc-89a9514a0659bcc1"><data key="label">The Book of Damascus: My complicated love affair</data><data key="type">document</data></node><node id="doc-f3c467829fc37bbf"><data key="label">Syria reconnects to global finance, but ordinary Syrians are still struggling</data><data key="type">document</data></node><node id="doc-5325024bfc3b8e38"><data key="label">Syria’s Kurds fight to keep their language alive in the classroom</data><data key="type">document</data></node><node id="doc-db20ae6e7b5492ec"><data key="label">What Syria’s revolution can teach the world about democracy</data><data key="type">document</data></node><node id="doc-87c0d09ebd3625b5"><data key="label">The Damascus oud maker fighting to keep a generations-old craft alive</data><data key="type">document</data></node><node id="claim-damascus-legal-access"><data key="label">UNHCR reported an EU High Representative visit to a partner-supported legal clinic in Damascus, including meetings with displaced people and returnees.</data><data key="type">claim</data></node><node id="claim-aleppo-water"><data key="label">UN-Habitat and partners announced completion of work to restore water access and repair associated urban infrastructure in eastern Aleppo.</data><data key="type">claim</data></node><node id="claim-homs-urban-recovery"><data key="label">Japan and UN-Habitat announced a programme for public-space renewal and municipal waste management in Homs.</data><data key="type">claim</data></node><node id="claim-suwayda-protection"><data key="label">UNHCR’s April–June monitoring recorded conflict-related safety concerns in As-Sweida and access constraints across the southern region.</data><data key="type">claim</data></node><node id="claim-syrian-coast-community-protection"><data key="label">Community consultations described psychosocial distress, social-cohesion concerns and difficult living conditions in the coastal region.</data><data key="type">claim</data></node><node id="claim-al-shaddadi-community-services"><data key="label">UNHCR reported opening a community centre in Al-Shaddadi to support protection and returnee reintegration.</data><data key="type">claim</data></node><node id="claim-raqqa-community-accountability"><data key="label">UNHCR reported partner training in community engagement, feedback and complaints mechanisms in Qamishli and Ar-Raqqa.</data><data key="type">claim</data></node><node id="claim-deir-ez-zor-supported-returns"><data key="label">UNHCR reported assisting returns from six displacement sites in Deir-ez-Zor as part of a programme spanning several governorates.</data><data key="type">claim</data></node><node id="claim-idleb-northwest-reintegration"><data key="label">UNHCR’s north-west findings connect return movements with pressure on housing, livelihoods, documentation and essential services.</data><data key="type">claim</data></node><node id="area-damascus-legal-access"><data key="label">Damascus</data><data key="type">place</data></node><node id="area-aleppo-water"><data key="label">Eastern Aleppo</data><data key="type">place</data></node><node id="area-homs-urban-recovery"><data key="label">Homs</data><data key="type">place</data></node><node id="area-suwayda-protection"><data key="label">As-Sweida / Suwayda area</data><data key="type">place</data></node><node id="area-syrian-coast-community-protection"><data key="label">Syrian coast: Latakia and Tartous</data><data key="type">place</data></node><node id="area-al-shaddadi-community-services"><data key="label">Al-Shaddadi</data><data key="type">place</data></node><node id="area-raqqa-community-accountability"><data key="label">Ar-Raqqa area</data><data key="type">place</data></node><node id="area-deir-ez-zor-supported-returns"><data key="label">Deir-ez-Zor governorate</data><data key="type">place</data></node><node id="area-idleb-northwest-reintegration"><data key="label">Idleb / north-west</data><data key="type">place</data></node><node id="context-political-process-mandate"><data key="label">The UN political-process mandate</data